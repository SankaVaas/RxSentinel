# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
POSTGRES_USER=rxsentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rxsentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rxsentinel:change-me@db:5432/rxsentinel

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- External APIs ---
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
OPENFDA_API_BASE=https://api.fda.gov
DAILYMED_API_BASE=https://dailymed.nlm.nih.gov/dailymed/services/v2

# --- Auth (OIDC) ---
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=https://rxsentinel.api
OIDC_CLIENT_ID=change-me

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
